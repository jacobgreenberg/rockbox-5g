#! rockbox/tagbrowser/2.0
%menu_start "music" "Music"
"Artists"     -> albumartist ? filename ^ "/Music/" -> album -> title = "fmt_title" %hide_special
"Albums"      -> album ? filename ^ "/Music/" -> title = "fmt_title" %hide_special
"Songs"       -> title ? filename ^ "/Music/" = "fmt_title"
"Shuffle Songs" ~> title ? filename ^ "/Music/" = "fmt_title"

%menu_start "podcasts" "Podcasts"
"Continue listening" -> title ? filename ^ "/Podcasts/" & lastelapsed > "0" = "fmt_title"
"Shows" @> "/Podcasts"
"All episodes" -> title ? filename ^ "/Podcasts/" = "fmt_title"

%menu_start "meditation" "Meditation & Sleep"
"Meditation" -> title ? filename ^ "/Meditation/" = "fmt_title"
"Sleep" -> title ? filename ^ "/Sleep/" = "fmt_title"
